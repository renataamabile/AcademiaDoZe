<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="AcademiaDoZe.Presentation.AppMaui.Views.ConfigPage"
    Title="Configurações">

    <ScrollView>

        <StackLayout Spacing="20">

            <!-- ================================================= -->
            <!-- TEMA                                             -->
            <!-- ================================================= -->

            <Border
                Style="{StaticResource CardBorder}"
                Margin="15,10">

                <StackLayout Spacing="15">

                    <Label
                        Text="Tema"
                        Style="{StaticResource SubHeadline}" />

                    <StackLayout Spacing="5">

                        <Label Text="Tema" />

                        <Picker
                            x:Name="TemaPicker">

                            <Picker.ItemsSource>

                                <x:Array Type="{x:Type x:String}">

                                    <x:String>light</x:String>
                                    <x:String>dark</x:String>
                                    <x:String>system</x:String>

                                </x:Array>

                            </Picker.ItemsSource>

                        </Picker>

                    </StackLayout>

                    <!-- BOTÕES DO TEMA -->

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <!-- CANCELAR -->

                        <Button
                            Grid.Column="0"
                            Text="Cancelar"
                            Clicked="OnCancelarClicked"
                            Style="{StaticResource ButtonSecondary}"
                            HeightRequest="45">

                            <Button.ImageSource>

                                <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe5c9;"
                                    Color="{AppThemeBinding Light=Black, Dark=White}" />

                            </Button.ImageSource>

                        </Button>

                        <!-- SALVAR TEMA -->

                        <Button
                            Grid.Column="1"
                            Text="Salvar Tema"
                            Clicked="OnSalvarTemaClicked"
                            Style="{StaticResource ButtonPrimary}"
                            HeightRequest="45">

                            <Button.ImageSource>

                                <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe161;"
                                    Color="{AppThemeBinding Light=Black, Dark=White}" />

                            </Button.ImageSource>

                        </Button>

                    </Grid>

                </StackLayout>

            </Border>


            <!-- ================================================= -->
            <!-- CREDENCIAIS DO BANCO                             -->
            <!-- ================================================= -->

            <Border
                Style="{StaticResource CardBorder}"
                Margin="15,10">

                <StackLayout Spacing="15">

                    <Label
                        Text="Credenciais do Banco"
                        Style="{StaticResource SubHeadline}" />


                    <!-- ================================================= -->
                    <!-- TIPO DE GERENCIADOR                              -->
                    <!-- ================================================= -->

                    <StackLayout Spacing="5">

                        <Label
                            Text="Tipo de Gerenciador" />

                        <Picker
                            x:Name="DatabaseTypePicker"
                            SelectedIndexChanged="OnDatabaseTypeChanged" />

                    </StackLayout>


                    <!-- ================================================= -->
                    <!-- INFORMAÇÃO DO SQLITE                             -->
                    <!-- ================================================= -->

                    <Border
                        x:Name="SqliteInfoCard"
                        IsVisible="False"
                        BackgroundColor="{AppThemeBinding Light=#F0F7FF, Dark=#1A2633}"
                        StrokeShape="RoundRectangle 8"
                        Padding="12">

                        <Label
                            Text="O SQLite é um banco de dados local armazenado em arquivo. Não requer servidor de rede, usuário ou senha."
                            FontSize="13"
                            TextColor="{AppThemeBinding Light=#0056B3, Dark=#66B2FF}" />

                    </Border>


                    <!-- ================================================= -->
                    <!-- SQLITE - CAMINHO                                 -->
                    <!-- ================================================= -->

                    <StackLayout
                        x:Name="SqliteContainer"
                        Spacing="5"
                        IsVisible="False">

                        <Label
                            Text="Caminho / Arquivo do Banco (.db)" />

                        <Entry
                            x:Name="SqliteCaminhoEntry"
                            Placeholder="Ex: C:\DEV\AcademiaDoZe\db_academia_do_ze.db" />

                    </StackLayout>


                    <!-- ================================================= -->
                    <!-- SERVIDOR E BANCO                                 -->
                    <!-- ================================================= -->

                    <Grid
                        x:Name="ServidorBancoGrid"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <!-- SERVIDOR -->

                        <StackLayout
                            Spacing="5"
                            Grid.Column="0">

                            <Label
                                Text="Servidor" />

                            <Entry
                                x:Name="ServidorEntry"
                                Placeholder="Digite o servidor..." />

                        </StackLayout>


                        <!-- BANCO -->

                        <StackLayout
                            Spacing="5"
                            Grid.Column="1">

                            <Label
                                Text="Banco" />

                            <Entry
                                x:Name="BancoEntry"
                                Placeholder="Digite o nome do banco..." />

                        </StackLayout>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- USUÁRIO E SENHA                                  -->
                    <!-- ================================================= -->

                    <Grid
                        x:Name="CredenciaisGrid"
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10">

                        <!-- USUÁRIO -->

                        <StackLayout
                            Spacing="5"
                            Grid.Column="0">

                            <Label
                                Text="Usuário" />

                            <Entry
                                x:Name="UsuarioEntry"
                                Placeholder="Digite o usuário..." />

                        </StackLayout>


                        <!-- SENHA -->

                        <StackLayout
                            Spacing="5"
                            Grid.Column="1">

                            <Label
                                Text="Senha" />

                            <Entry
                                x:Name="SenhaEntry"
                                Placeholder="Digite a senha..."
                                IsPassword="True" />

                        </StackLayout>

                    </Grid>


                    <!-- ================================================= -->
                    <!-- COMPLEMENTO                                      -->
                    <!-- ================================================= -->

                    <StackLayout
                        Spacing="5">

                        <Label
                            x:Name="ComplementoLabel"
                            Text="Complemento" />

                        <Entry
                            x:Name="ComplementoEntry"
                            Placeholder="Digite o complemento..." />

                    </StackLayout>


                    <!-- ================================================= -->
                    <!-- BOTÕES DO BANCO                                 -->
                    <!-- ================================================= -->

                    <Grid
                        ColumnDefinitions="*,*"
                        ColumnSpacing="10"
                        Margin="15,10">

                        <!-- CANCELAR -->

                        <Button
                            Grid.Column="0"
                            Text="Cancelar"
                            Clicked="OnCancelarClicked"
                            Style="{StaticResource ButtonSecondary}"
                            HeightRequest="45">

                            <Button.ImageSource>

                                <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe5c9;"
                                    Color="{AppThemeBinding Light=Black, Dark=White}" />

                            </Button.ImageSource>

                        </Button>


                        <!-- SALVAR BD -->

                        <Button
                            Grid.Column="1"
                            Text="Salvar BD"
                            Clicked="OnSalvarBdClicked"
                            Style="{StaticResource ButtonPrimary}"
                            HeightRequest="45">

                            <Button.ImageSource>

                                <FontImageSource
                                    FontFamily="MaterialIcons"
                                    Glyph="&#xe161;"
                                    Color="{AppThemeBinding Light=Black, Dark=White}" />

                            </Button.ImageSource>

                        </Button>

                    </Grid>

                </StackLayout>

            </Border>

        </StackLayout>

    </ScrollView>

</ContentPage>