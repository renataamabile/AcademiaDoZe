<?xml version="1.0" encoding="UTF-8" ?>

<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Cores principais -->
    <Color x:Key="Primary">#8E24AA</Color>
    <Color x:Key="PrimaryDark">#CE93D8</Color>
    <Color x:Key="PrimaryLight">#BA68C8</Color>

    <!-- Cores básicas -->
    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <!-- Cinzas -->
    <Color x:Key="Gray100">#F5F5F5</Color>
    <Color x:Key="Gray200">#E0E0E0</Color>
    <Color x:Key="Gray300">#BDBDBD</Color>
    <Color x:Key="Gray400">#9E9E9E</Color>
    <Color x:Key="Gray500">#757575</Color>
    <Color x:Key="Gray600">#616161</Color>
    <Color x:Key="Gray700">#424242</Color>
    <Color x:Key="Gray900">#212121</Color>

    <!-- Fundo escuro -->
    <Color x:Key="PageBackground">#17121C</Color>

    <!-- Fundo dos cards -->
    <Color x:Key="CardBackground">#29212F</Color>

    <!-- Texto -->
    <Color x:Key="TextPrimary">#FFFFFF</Color>
    <Color x:Key="TextSecondary">#D1C4E9</Color>

    <!-- Bordas -->
    <Color x:Key="CardBorderColor">#4A3A55</Color>

    <!-- Brushes -->
    <SolidColorBrush
        x:Key="PrimaryBrush"
        Color="{StaticResource Primary}" />

    <SolidColorBrush
        x:Key="PrimaryDarkBrush"
        Color="{StaticResource PrimaryDark}" />

</ResourceDictionary>